            { "source": "each", "target": "report", "sourcePort": "done", "targetPort": "in" },
            { "source": "report", "target": "tell", "sourcePort": "out", "targetPort": "in" },
            { "source": "report", "target": "summary", "sourcePort": "out", "targetPort": "in" },
            { "source": "tell", "target": "join", "sourcePort": "out", "targetPort": "in" },
            { "source": "summary", "target": "join", "sourcePort": "out", "targetPort": "in" },
            { "source": "join", "target": "done", "sourcePort": "out", "targetPort": "in" }
        ]
    }
