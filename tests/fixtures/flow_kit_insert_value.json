{
    "about": "The Main and InsertValue mocks' flow, 'Sync applications from the portal' (2026-10-06), as a logic graph, with a catalogue carrying the roles Tables' engine declares. alwaysBefore's first test case: from 'invite' (Send the invitation) the steps that always run before are listed nearest first, and 'portaldown' (Stop: the portal is down), 'checkfail' and 'nothing' are not.",
    "types": [
        { "type_id": "start", "label": "Start", "role": "start", "category": "control",
          "ports": [{ "name": "out", "direction": "output", "port_type": "FLOW" }] },
        { "type_id": "http-request", "label": "HTTP request", "role": "step", "category": "integration",
          "ports": [{ "name": "in", "direction": "input", "port_type": "FLOW", "multiple": true },
                    { "name": "out", "direction": "output", "port_type": "FLOW" },
                    { "name": "error", "direction": "output", "port_type": "FLOW" },
                    { "name": "response", "direction": "output", "port_type": "DATA" }] },
        { "type_id": "upsert-rows", "label": "Insert or update rows", "role": "step", "category": "data",
          "ports": [{ "name": "in", "direction": "input", "port_type": "FLOW", "multiple": true },
                    { "name": "out", "direction": "output", "port_type": "FLOW" }] },
        { "type_id": "condition", "label": "Condition", "role": "branch", "category": "control",
          "ports": [{ "name": "in", "direction": "input", "port_type": "FLOW", "multiple": true },
                    { "name": "true", "direction": "output", "port_type": "FLOW" },
                    { "name": "false", "direction": "output", "port_type": "FLOW" }] },
        { "type_id": "loop-over-rows", "label": "Loop over rows", "role": "loop", "category": "control",
          "ports": [{ "name": "in", "direction": "input", "port_type": "FLOW" },
                    { "name": "next", "direction": "input", "port_type": "FLOW", "multiple": true },
                    { "name": "body", "direction": "output", "port_type": "FLOW" },
                    { "name": "done", "direction": "output", "port_type": "FLOW" }] },
        { "type_id": "log", "label": "Log", "role": "step", "category": "utility",
          "ports": [{ "name": "in", "direction": "input", "port_type": "FLOW", "multiple": true },
                    { "name": "out", "direction": "output", "port_type": "FLOW" }] },
        { "type_id": "end", "label": "End", "role": "end", "category": "control",
          "ports": [{ "name": "in", "direction": "input", "port_type": "FLOW", "multiple": true }] },
        { "type_id": "parallel", "label": "Parallel", "role": "fanout", "category": "control",
          "ports": [{ "name": "in", "direction": "input", "port_type": "FLOW", "multiple": true },
                    { "name": "out", "direction": "output", "port_type": "FLOW", "multiple": true }] },
        { "type_id": "merge", "label": "Merge", "role": "join", "category": "control",
          "ports": [{ "name": "in", "direction": "input", "port_type": "FLOW", "multiple": true },
                    { "name": "out", "direction": "output", "port_type": "FLOW" }] }
    ],
    "graph": {
        "nodes": [
            { "id": "start", "type": "start", "config": {}, "position": { "x": 0, "y": 0 } },
            { "id": "fetch", "type": "http-request", "label": "Fetch new applications", "config": {}, "position": { "x": 0, "y": 0 } },
            { "id": "portaldown", "type": "end", "label": "Stop: the portal is down", "config": {}, "position": { "x": 0, "y": 0 } },
            { "id": "save", "type": "upsert-rows", "label": "Save the applications", "config": {}, "position": { "x": 0, "y": 0 } },
            { "id": "anynew", "type": "condition", "label": "Anything new?", "config": {}, "position": { "x": 0, "y": 0 } },
            { "id": "each", "type": "loop-over-rows", "label": "For each new application", "config": {}, "position": { "x": 0, "y": 0 } },
            { "id": "check", "type": "http-request", "label": "Check eligibility", "config": {}, "position": { "x": 0, "y": 0 } },
            { "id": "checkfail", "type": "log", "label": "Note it and move on", "config": {}, "position": { "x": 0, "y": 0 } },
            { "id": "invite", "type": "http-request", "label": "Send the invitation", "config": {}, "position": { "x": 0, "y": 0 } },
            { "id": "nothing", "type": "end", "label": "Stop: nothing new", "config": {}, "position": { "x": 0, "y": 0 } },
            { "id": "report", "type": "parallel", "label": "At the same time", "config": {}, "position": { "x": 0, "y": 0 } },
