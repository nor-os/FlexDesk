{
  "about": "A step catalogue in a logic-flow consumer's wire shape (type_id, label, category, role, description, icon, ports, config_schema, unavailable), modelled on the first consumer's thirteen built-in steps: their roles, their ports in declared order and the shape of their settings. The outline suites read it; the block mapping that goes with it is in tests/flow_outline_fixtures.mjs, because a mapping carries functions.",
  "categories": [
    { "id": "control", "label": "Flow", "tone": "violet" },
    { "id": "data", "label": "Data", "tone": "teal", "layout": "grid" },
    { "id": "integration", "label": "Integration", "tone": "amber", "layout": "grid" },
    { "id": "util", "label": "Utility", "tone": "grey", "layout": "grid" }
  ],
  "types": [
    { "type_id": "start", "label": "Start", "category": "control", "role": "start", "icon": "play_arrow",
      "description": "Where every run begins.",
      "ports": [ { "name": "out", "direction": "output", "port_type": "FLOW", "label": "out", "required": false, "multiple": false } ],
      "config_schema": { "type": "object", "additionalProperties": false, "properties": {} } },
    { "type_id": "end", "label": "End", "category": "control", "role": "end", "icon": "stop",
      "description": "Ends the run. A failed outcome fails the run and is never retried.",
      "ports": [ { "name": "in", "direction": "input", "port_type": "FLOW", "label": "in", "required": false, "multiple": true } ],
      "config_schema": { "type": "object", "additionalProperties": false, "properties": {
        "outcome": { "type": "string", "enum": ["success", "failed"], "default": "success", "title": "Outcome" },
        "output": { "type": "object", "title": "Run output", "x-ui-widget": "key-value-map" },
        "message": { "type": "string", "title": "Message", "x-ui-widget": "template" } } } },
    { "type_id": "condition", "label": "Condition", "category": "control", "role": "branch", "icon": "call_split",
      "description": "Continues on true or false, by a formula over the run's values.",
      "ports": [ { "name": "in", "direction": "input", "port_type": "FLOW", "label": "in", "required": false, "multiple": true },
                 { "name": "true", "direction": "output", "port_type": "FLOW", "label": "True", "required": false, "multiple": false },
                 { "name": "false", "direction": "output", "port_type": "FLOW", "label": "False", "required": false, "multiple": false } ],
      "config_schema": { "type": "object", "additionalProperties": false, "required": ["expression"], "properties": {
        "expression": { "type": "string", "minLength": 1, "title": "Formula", "x-ui-widget": "expression" } } } },
    { "type_id": "parallel", "label": "Parallel", "category": "control", "role": "fanout", "icon": "account_tree",
      "description": "Runs every connected branch at the same time.",
      "ports": [ { "name": "in", "direction": "input", "port_type": "FLOW", "label": "in", "required": false, "multiple": true },
                 { "name": "out", "direction": "output", "port_type": "FLOW", "label": "out", "required": false, "multiple": true } ],
      "config_schema": { "type": "object", "additionalProperties": false, "properties": {} } },
    { "type_id": "merge", "label": "Merge", "category": "control", "role": "join", "icon": "merge",
      "description": "Waits for its branches: all that ran, or the first to finish.",
      "ports": [ { "name": "in", "direction": "input", "port_type": "FLOW", "label": "in", "required": false, "multiple": true },
                 { "name": "out", "direction": "output", "port_type": "FLOW", "label": "out", "required": false, "multiple": false } ],
      "config_schema": { "type": "object", "additionalProperties": false, "properties": {
        "join": { "type": "string", "enum": ["all", "any"], "default": "all", "title": "Wait for" } } } },
    { "type_id": "loop-over-rows", "label": "Loop over rows", "category": "control", "role": "loop", "icon": "repeat",
      "description": "Runs its body once per row, a page at a time.",
      "ports": [ { "name": "in", "direction": "input", "port_type": "FLOW", "label": "in", "required": false, "multiple": true },
                 { "name": "next", "direction": "input", "port_type": "FLOW", "label": "Next", "required": true, "multiple": true },
                 { "name": "body", "direction": "output", "port_type": "FLOW", "label": "Body", "required": false, "multiple": false },
                 { "name": "done", "direction": "output", "port_type": "FLOW", "label": "Done", "required": false, "multiple": false } ],
      "config_schema": { "type": "object", "additionalProperties": false, "required": ["table"], "properties": {
        "table": { "type": "string", "title": "Table" },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 5000, "default": 500, "title": "Rows per page" } } } },
    { "type_id": "set-variable", "label": "Set variable", "category": "data", "role": "step", "icon": "data_object",
      "description": "Assigns the run's variables, from a value or a formula.",
      "ports": [ { "name": "in", "direction": "input", "port_type": "FLOW", "label": "in", "required": false, "multiple": true },
                 { "name": "out", "direction": "output", "port_type": "FLOW", "label": "out", "required": false, "multiple": false } ],
      "config_schema": { "type": "object", "additionalProperties": false, "required": ["assignments"], "properties": {
        "assignments": { "type": "array", "minItems": 1, "title": "Assignments", "x-ui-widget": "key-value-list",
          "items": { "type": "object", "additionalProperties": false, "required": ["variable"], "properties": {
            "variable": { "type": "string", "minLength": 1, "maxLength": 64 },
            "value": { "title": "Value (references allowed)" },
            "expression": { "type": "string", "x-ui-widget": "expression" } } } } } } },
    { "type_id": "log", "label": "Log", "category": "util", "role": "step", "icon": "notes",
      "description": "Writes a line into this step's run log.",
      "ports": [ { "name": "in", "direction": "input", "port_type": "FLOW", "label": "in", "required": false, "multiple": true },
                 { "name": "out", "direction": "output", "port_type": "FLOW", "label": "out", "required": false, "multiple": false } ],
      "config_schema": { "type": "object", "additionalProperties": false, "required": ["message"], "properties": {
        "level": { "type": "string", "enum": ["info", "warning", "error"], "default": "info" },
        "message": { "type": "string", "minLength": 1, "x-ui-widget": "template" },
        "fields": { "type": "object", "x-ui-widget": "key-value-map" } } } },
    { "type_id": "table-read", "label": "Read rows", "category": "data", "role": "step", "icon": "table_view",
      "description": "Reads rows, as the run's identity.",
      "ports": [ { "name": "in", "direction": "input", "port_type": "FLOW", "label": "in", "required": false, "multiple": true },
                 { "name": "out", "direction": "output", "port_type": "FLOW", "label": "out", "required": false, "multiple": false },
                 { "name": "empty", "direction": "output", "port_type": "FLOW", "label": "No rows", "required": false, "multiple": false },
                 { "name": "rows", "direction": "output", "port_type": "DATA", "label": "Rows", "required": false, "multiple": false } ],
      "config_schema": { "type": "object", "additionalProperties": false, "required": ["table", "limit"], "properties": {
        "table": { "type": "string", "title": "Table" },
        "mode": { "type": "string", "enum": ["rows", "single", "count"], "default": "rows" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 1000, "title": "At most" } } } },
    { "type_id": "table-write", "label": "Insert rows", "category": "data", "role": "step", "icon": "add_box",
      "description": "Inserts rows, as the run's identity.",
      "ports": [ { "name": "in", "direction": "input", "port_type": "FLOW", "label": "in", "required": false, "multiple": true },
                 { "name": "out", "direction": "output", "port_type": "FLOW", "label": "out", "required": false, "multiple": false },
                 { "name": "result", "direction": "output", "port_type": "DATA", "label": "Result", "required": false, "multiple": false } ],
      "config_schema": { "type": "object", "additionalProperties": false, "required": ["table", "rows"], "properties": {
        "table": { "type": "string", "title": "Table" },
        "rows": { "type": ["string", "array"], "title": "Rows", "x-ui-widget": "template" } } } },
    { "type_id": "table-upsert", "label": "Insert or update rows", "category": "data", "role": "step", "icon": "sync",
      "description": "Inserts rows, or updates the row with the same value in a unique column.",
      "ports": [ { "name": "in", "direction": "input", "port_type": "FLOW", "label": "in", "required": false, "multiple": true },
                 { "name": "out", "direction": "output", "port_type": "FLOW", "label": "out", "required": false, "multiple": false },
                 { "name": "result", "direction": "output", "port_type": "DATA", "label": "Result", "required": false, "multiple": false } ],
      "config_schema": { "type": "object", "additionalProperties": false, "required": ["table", "rows"], "properties": {
        "table": { "type": "string", "title": "Table" },
        "rows": { "type": ["string", "array"], "title": "Rows", "x-ui-widget": "template" },
        "compensate": { "type": "string", "enum": ["auto", "none"], "default": "auto", "title": "If a later step fails",
                        "x-ui-widget": "choice-cards" } } } },
    { "type_id": "table-delete", "label": "Delete rows", "category": "data", "role": "step", "icon": "delete",
      "description": "Deletes rows by id or by filter, as the run's identity.",
      "ports": [ { "name": "in", "direction": "input", "port_type": "FLOW", "label": "in", "required": false, "multiple": true },
                 { "name": "out", "direction": "output", "port_type": "FLOW", "label": "out", "required": false, "multiple": false },
                 { "name": "result", "direction": "output", "port_type": "DATA", "label": "Result", "required": false, "multiple": false } ],
      "config_schema": { "type": "object", "additionalProperties": false, "required": ["table"], "properties": {
        "table": { "type": "string", "title": "Table" } } } },
    { "type_id": "http-request", "label": "HTTP request", "category": "integration", "role": "step", "icon": "public",
      "description": "Calls an HTTP endpoint and hands its answer to the steps after it.",
      "ports": [ { "name": "in", "direction": "input", "port_type": "FLOW", "label": "in", "required": false, "multiple": true },
                 { "name": "out", "direction": "output", "port_type": "FLOW", "label": "out", "required": false, "multiple": false },
                 { "name": "error", "direction": "output", "port_type": "FLOW", "label": "Error", "required": false, "multiple": false },
                 { "name": "response", "direction": "output", "port_type": "DATA", "label": "Response", "required": false, "multiple": false } ],
      "config_schema": { "type": "object", "additionalProperties": false, "required": ["url"], "properties": {
        "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"], "default": "GET" },
        "url": { "type": "string", "minLength": 1, "maxLength": 2048, "x-ui-widget": "template" },
        "headers": { "type": "object", "title": "Headers", "x-ui-widget": "key-value-map" },
        "body": { "type": ["string", "object", "array"], "title": "Body", "x-ui-widget": "json-body" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 60, "default": 30 } } } },
    { "type_id": "send-email", "label": "Send an email", "category": "integration", "role": "step", "icon": "mail",
      "description": "Sends one email.",
      "unavailable": "Sending email is not built yet.",
      "ports": [ { "name": "in", "direction": "input", "port_type": "FLOW", "label": "in", "required": false, "multiple": true },
                 { "name": "out", "direction": "output", "port_type": "FLOW", "label": "out", "required": false, "multiple": false } ],
      "config_schema": { "type": "object", "additionalProperties": false, "properties": {} } }
  ]
}
